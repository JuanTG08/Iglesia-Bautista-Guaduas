---
import Header from "./partials/Header.astro";
import config from "@/config/config.json";
import { AstroFont } from "astro-font";
const { title, navPosition = "sticky" } = Astro.props;
import theme from "@/config/theme.json";
import "@/styles/main.scss";
import Footer from "./partials/Footer.astro";

// font families
const pf = theme.fonts.font_family.primary;
const sf = theme.fonts.font_family.secondary;

let fontPrimary, fontSecondary;
if (theme.fonts.font_family.primary) {
  fontPrimary = theme.fonts.font_family.primary
    .replace(/\+/g, " ")
    .replace(/:[ital,]*[ital@]*[wght@]*[0-9,;]+/gi, "");
}
if (theme.fonts.font_family.secondary) {
  fontSecondary = theme.fonts.font_family.secondary
    .replace(/\+/g, " ")
    .replace(/:[ital,]*[ital@]*[wght@]*[0-9,;]+/gi, "");
}
---

<!doctype html>
<html lang="es">
  <head>
    <link rel="shortcut icon" href={config.site.favicon} />
    <meta name="theme-name" content="IBAGU" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <AstroFont
      config={[
        {
          src: [],
          preload: false,
          display: "swap",
          name: fontPrimary!,
          fallback: "sans-serif",
          cssVariable: "font-primary",
          googleFontsURL: `https://fonts.googleapis.com/css2?family=${pf}&display=swap`,
        },
        {
          src: [],
          preload: false,
          display: "swap",
          name: fontSecondary!,
          fallback: "sans-serif",
          cssVariable: "font-secondary",
          googleFontsURL: `https://fonts.googleapis.com/css2?family=${sf}&display=swap`,
        },
      ]}
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <Header position={navPosition} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <!-- Small vanilla JS to handle accordions using data-accordion attributes -->
    <script>
      (function () {
        if (typeof window === 'undefined') return;

        function initAccordions(root = document) {
          const containers = Array.from(root.querySelectorAll('[data-accordion]'));
          containers.forEach((container) => {
            // support single-open collapse behavior when data-accordion="collapse"
            const collapse = container.getAttribute('data-accordion') === 'collapse';

            container.querySelectorAll('[data-accordion-target]').forEach((btn) => {
              const targetSelector = btn.getAttribute('data-accordion-target');
              if (!targetSelector) return;
              const panel = container.querySelector(targetSelector);
              if (!panel) return;
              const panelEl = /** @type {HTMLElement} */ (panel);

              // ensure initial aria state
              btn.setAttribute('aria-expanded', btn.getAttribute('aria-expanded') || 'false');
              if (btn.getAttribute('aria-expanded') === 'true') {
                panelEl.classList.remove('hidden');
              } else {
                panelEl.classList.add('hidden');
              }

              btn.addEventListener('click', function (e) {
                const isOpen = btn.getAttribute('aria-expanded') === 'true';

                if (collapse) {
                  // close other panels
                  container.querySelectorAll('[data-accordion-target]').forEach((other) => {
                    if (other === btn) return;
                    const otherTarget = other.getAttribute('data-accordion-target');
                    if (!otherTarget) return;
                    const otherPanel = container.querySelector(otherTarget);
                    const otherPanelEl = otherPanel ? /** @type {HTMLElement} */ (otherPanel) : null;
                    other.setAttribute('aria-expanded', 'false');
                    if (otherPanelEl) otherPanelEl.classList.add('hidden');
                    const otherIcon = other.querySelector('[data-accordion-icon]');
                    if (otherIcon && otherIcon instanceof HTMLElement) otherIcon.style.transform = 'rotate(180deg)';
                  });
                }

                // toggle this
                btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
                if (isOpen) {
                  panelEl.classList.add('hidden');
                } else {
                  panelEl.classList.remove('hidden');
                }

                // icon rotation if present
                const icon = btn.querySelector('[data-accordion-icon]');
                if (icon && icon instanceof HTMLElement) {
                  // default markup uses rotate-180 class; we'll just toggle inline transform for reliability
                  icon.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
                }
              });
            });
          });
        }

        // init on DOMContentLoaded
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function () {
            initAccordions(document);
          });
        } else {
          initAccordions(document);
        }
      })();
    </script>
  </body>
</html>
