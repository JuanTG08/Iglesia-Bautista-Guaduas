---
import ImageMod from "@/components/ImageMod.astro";
import Subtitle from "@/components/Subtitle.astro";
import DynamicIcon from "@/helpers/DynamicIcon";
---

<section class={`section-sm`} id="ubicacion">
  <div class="container">
    <div class="row items-center justify-between">
      <div class={`mb:md-0 md:col-5 md:order-2`}>
        <ImageMod
          class="w-full rounded-lg shadow-md"
          src={"https://files.iglesiabautistadelsur.com/images/iglesia-bautista.avif"}
          height={640}
          width={427}
          alt={"Iglesia Bautista del Sur, Voz de Salvación, Guaduas, Templo"}
          format="avif"
          url={true}
        />
      </div>
      <div class={`md:col-7 lg:col-6 md:order-1`}>
        <Subtitle value="Nuestra Iglesia" />
        <p class="text-base md:text-lg mb-2 text-balance">
          Somos una Iglesia Bautista Reformada dedicada a glorificar a Dios a
          través del estudio de Su Palabra, la adoración sincera y el servicio
          amoroso a nuestra comunidad. Nos encontramos en la
          <strong>carrera 9 #8-20 sur</strong>, barrio
          <strong>Villa del Paraíso</strong>, Guaduas, Cundinamarca, Colombia.
        </p>
        <a
          href="/nuestra-iglesia"
          class="btn btn-primary w-full md:w-auto justify-center px-6 py-3 text-white shadow-lg transition duration-300 ease-in-out inline-flex gap-2 items-center"
        >
          <DynamicIcon className="inline-block text-lg" icon="FaCross" />
          Conoce más de nuestra iglesia
        </a>
      </div>
    </div>
  </div>
</section>
