---
import DynamicIcon from "@/helpers/DynamicIcon";
import { title } from "process";

const solas = [
  {
    title: "Sola Scriptura",
    description:
      "Creemos que la Biblia es la Palabra inspirada e infalible de Dios, nuestra única regla de fe y práctica. Todo lo que creemos, enseñamos y hacemos se basa en las Escrituras, que son suficientes y autoritarias.",
    icon: "FaBookBible",
  },
  {
    title: "Solus Christus",
    description:
      "Jesucristo es el único mediador entre Dios y los hombres, y la única esperanza de salvación. Su obra en la cruz es suficiente para redimir a los pecadores, y solo en Él encontramos la vida eterna.",
    icon: "FaCross",
  },
  {
    title: "Sola Gratia",
    description:
      "La salvación es un regalo inmerecido de Dios, dado únicamente por Su Gracia, sin mérito humano. Todo ser humano es incapaz de salvarse a sí mismo; es solo por la gracia de Dios que somos justificados y transformados.",
    icon: "FaHeart",
  },
  {
    title: "Sola Fide",
    description:
      "Somos justificados solo por la fe en Jesucristo, no por nuestras obras. La fe es el medio por el cual recibimos la justicia de Cristo y somos reconciliados con Dios.",
    icon: "FaFire",
  },
  {
    title: "Soli Deo Gloria",
    description:
      "Vivimos para la gloria de Dios. Todo lo que hacemos, desde nuestra adoración hasta nuestras actividades diarias, debe ser para la exaltación de Su nombre y el reflejo de Su carácter santo.",
    icon: "TbTriangleFilled",
  },
];
---

<section class="section-sm bg-gradient">
  <div class="container">
    <h2
      class="text-3xl lg:text-4xl font-extrabold my-4 text-gray-800 text-center"
    >
      Las Cinco Solas
    </h2>
    <ul
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 justify-items-center gap-8 pt-3 w-full"
    >
      {
        solas.map((sola) => (
          <div class="flex flex-col items-center">
            <DynamicIcon
              className="inline-block fill-primary w-10 h-10"
              icon={sola.icon}
            />
            <p class="text-2xl md:text-xl font-bold my-1">{sola.title}</p>
            <p class="text-lg text-gray-600">{sola.description}</p>
          </div>
        ))
      }
    </ul>
  </div>
</section>
