---
import ImageMod from "@/components/ImageMod.astro";
import DynamicIcon from "@/helpers/DynamicIcon";
---

<section class="section bg-primary" id="horario">
  <div class="container">
    <div class="flex flex-col items-center">
      <h2 class="text-3xl lg:text-4xl font-extrabold my-4 text-white">
        Horarios de Servicio
      </h2>
      <p class="text-base md:text-xl text-white/90">
        "Buscad a Jehová mientras puede ser hallado, llamadle en tanto que está
        cercano." Isaías 55:6
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-16 place-items-center my-16 text-center">
      <div>
        <h4 class="text-2xl lg:text-3xl font-extrabold text-white">
          Culto Principal
        </h4>
        <p class="text-base md:text-lg text-white/90">Domingos 10:00 a.m.</p>
      </div>
      <div class="flex flex-col gap-8">
        <div class="">
          <h4 class="text-2xl lg:text-3xl font-extrabold text-white">
            Culto de Oración
          </h4>
          <p class="text-base md:text-lg text-white/90">Jueves 6:00 p.m.</p>
        </div>
        <div class="">
          <h4 class="text-2xl lg:text-3xl font-extrabold text-white">
            Amanecer con Dios
          </h4>
          <p class="text-base md:text-lg text-white/90">Sábado 6:00 a.m.</p>
        </div>
      </div>
      <div class="flex flex-col gap-8">
        <div class="">
          <h4 class="text-2xl lg:text-3xl font-extrabold text-white">
            Estudio Bíblico
          </h4>
          <p class="text-base md:text-lg text-white/90">Viernes 6:00 p.m.</p>
        </div>
        <div class="">
          <h4 class="text-2xl lg:text-3xl font-extrabold text-white">
            Reunión de Damas y Caballeros
          </h4>
          <p class="text-base md:text-lg text-white/90">Sábado 6:00 p.m.</p>
        </div>
      </div>
    </div>
  </div>
</section>
