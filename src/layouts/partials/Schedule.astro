---
import ImageMod from "@/components/ImageMod.astro";
import DynamicIcon from "@/helpers/DynamicIcon";
---

<section class="section bg-indigo-100" id="horario">
  <div class="container">
    <div class="flex flex-col items-center">
      <h2 class="text-3xl lg:text-4xl font-extrabold my-4 text-gray-800">
        Horarios de Servicio
      </h2>
      <p class="text-base md:text-lg text-black">
        "Buscad a Jehová mientras puede ser hallado, llamadle en tanto que está
        cercano." Isaías 55:6
      </p>
    </div>
    <div class="grid md:grid-cols-2 gap-16 place-items-center my-16">
      <div
        class="flex flex-col md:gap-4 items-center text-center"
      >
        <div class="grid md:grid-cols-2 gap-4 md:gap-16 place-items-center">
          <div class="">
            <h4 class="text-2xl lg:text-3xl font-extrabold text-gray-800">
              Escuela Dominical
            </h4>
            <p class="text-base md:text-lg">Domingos 10:00 a.m.</p>
          </div>
          <div class="">
            <h4 class="text-2xl lg:text-3xl font-extrabold text-gray-800">
              Servicio Principal
            </h4>
            <p class="text-base md:text-lg">Domingos 11 :00 a.m.</p>
          </div>
        </div>
        <div class="w-full">
          <h4 class="mt-4 text-2xl lg:text-3xl font-extrabold text-gray-800">
            Escuela de Eclesiología
          </h4>
          <p class="text-base md:text-lg">Domingos 5 :00 p.m.</p>
        </div>
      </div>
      <div class="flex flex-col gap-4 items-center">
        <div class="w-full flex flex-col gap-4 items-center text-center">
          <div class="w-full grid md:grid-cols-2 place-items-center gap-8">
            <div class="">
              <h4 class="text-2xl lg:text-3xl font-extrabold text-gray-800">
                Estudio Bíblico
              </h4>
              <p class="text-base md:text-lg">Lunes 6:00 p.m.</p>
            </div>
            <div class="">
              <h4 class="text-2xl lg:text-3xl font-extrabold text-gray-800">
                Culto de Oración
              </h4>
              <p class="text-base md:text-lg">Jueves 6:00 p.m.</p>
            </div>
            <div class="">
              <h4 class="text-2xl lg:text-3xl font-extrabold text-gray-800">
                Estudio Bíblico (Génesis)
              </h4>
              <p class="text-base md:text-lg">Viernes 6:00 p.m.</p>
            </div>
            <div class="">
              <h4 class="text-2xl lg:text-3xl font-extrabold text-gray-800">
                Amanecer con Dios
              </h4>
              <p class="text-base md:text-lg">Sábado 6:00 a.m.</p>
            </div>
            <div class="">
              <h4 class="text-2xl lg:text-3xl font-extrabold text-gray-800">
                Reunión de Damas
              </h4>
              <p class="text-base md:text-lg">Sábado 4:00 p.m.</p>
            </div>
            <div class="">
              <h4 class="text-2xl lg:text-3xl font-extrabold text-gray-800">
                Reunión de Jóvenes
              </h4>
              <p class="text-base md:text-lg">Sábado 6:00 p.m.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
