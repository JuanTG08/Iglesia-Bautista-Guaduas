---
import ImageMod from "@/components/ImageMod.astro";
import Countdown from "@/helpers/Countdown.tsx";
---

<section class={`section bg-primary`}>
  <div class="container">
    <div class="row items-center justify-between gap-10">
      <h1 class="text-white text-center">¡Próximo Gran Evento!</h1>
      <div class={`mb:md-0 md:col-5 md:order-1`}>
        <ImageMod
          class="w-full rounded-lg shadow-md"
          src={"/images/cross.jpg"}
          height={640}
          width={427}
          alt={"Creciendo en Dios"}
          format="webp"
        />
      </div>
      <div class={`md:col-7 lg:col-6 md:order-2 text-left md:text-center lg:text-left flex flex-col gap-6`}>
        <h2 class="text-3xl lg:text-5xl font-extrabold text-white text-balance">
          ¡Vigilia Conmemoración de la Reforma Protestante!
        </h2>
        <p class="text-xl text-white">
          Únete a nosotros para una noche especial de adoración, oración, comunión y estudio de la Palabra de Dios.
        </p>
        <div class="text-xl text-white px-4">
          <p><strong>- Fecha:</strong> Viernes, 31 de Octubre</p>
          <p><strong>- Hora:</strong> 07:00 PM - 12:00 M</p>
          <p>
            <strong>- Lugar:</strong> Kra 9 #8-20 Sur, Villa del Paraíso, Guaduas,
            Cundinamarca
          </p>
        </div>
        <div class="h-28">
          <Countdown client:load targetDate="2025-10-31T19:00:00" />
        </div>
      </div>
    </div>
  </div>
</section>
