---
import Base from "@/layouts/Base.astro";
import NextEvent from "@/partials/NextEvent.astro";

const eventos = [
  {
    fecha: "Próximamente...",
    titulo: "Un Matrimonio para toda la vida",
    descripcion:
      "Como cristianos, entendemos la importancia de fortalecer los vínculos matrimoniales y familiares. Por ello, estamos organizando una serie de reuniones especiales para las parejas de nuestra iglesia. Estas reuniones están diseñadas para fomentar la comunicación, el entendimiento y el crecimiento espiritual en el contexto del matrimonio cristiano.",
  },
];
---

<Base title="Iglesia Bautista, Voz de Salvación | Eventos">
  <NextEvent />
  <section class="section-sm">
    <div class="container">
      <h1
        class="text-primary font-bold font-heading leading-tighter tracking-tighter mb-12 md:text-6xl text-5xl text-center text-balance"
      >
        Otros Eventos Próximos
      </h1>

      <div class="grid md:grid-cols-3 gap-5">
        {
          eventos.map((evento) => (
            <div class="border-2 rounded-lg p-4">
              <p class="text-gray-500 text-right">{evento.fecha}</p>
              <h2 class="text-2xl lg:text-3xl font-extrabold mb-4 text-gray-800 text-center md:text-left text-balance">
                {evento.titulo}
              </h2>
              <p class="text-base md:text-lg mb-6 text-black">
                {evento.descripcion}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
